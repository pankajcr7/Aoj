
# Public address of the site, used for the "Log in" link in emails
APP_URL="http://localhost:3000"

# ---- Email (any SMTP provider). Leave SMTP_HOST empty to skip email.
# Gmail: smtp.gmail.com, port 465, your address + a 16-character App Password (Google Account > Security > App passwords)
# Others: Zoho smtp.zoho.in | Brevo smtp-relay.brevo.com | Resend smtp.resend.com | Amazon SES
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="AOJ Punjab <no-reply@your-domain.in>"

# ---- SMS via MSG91 (India, DLT). Leave MSG91_AUTH_KEY empty to skip SMS.
# MSG91 > Authkey; one DLT-approved template per message (see README "SMS templates")
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_RECEIVED=""
MSG91_TEMPLATE_APPROVED=""
MSG91_TEMPLATE_REJECTED=""
MSG91_TEMPLATE_PASSWORD=""
